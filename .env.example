# Copy to .env or set in your host's secret settings. Never commit a real key.
QLOO_API_KEY=replace-with-your-event-credential
# Optional: force "demo" (sample data) or "live" (Qloo). Default: live if a key is set.
QLOO_MODE=
PORT=3000
# Hackathon event server (from the Qloo welcome email)
QLOO_BASE_URL=https://hackathon.api.qloo.com
QLOO_TRUSTED_BASE_URL=https://hackathon.api.qloo.com
